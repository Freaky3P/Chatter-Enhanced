# .gitignore for Chatter-Enhanced (WoW addon)
# Cleaned and tuned for this repository: keeps vendored Ace3 libs in Chatter/Libs tracked.

# Editor swap/temp files
*.swp
*.swo
*~

# macOS / Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.iml
.project
.classpath
.c9/
*.launch
.settings/

# Lua compiled files
*.luac
*.luac.out
luac.out

# Local testing / temporary folders
/test-addon/
/local-tests/
*.tmp
*.bak

# Logs and dumps
*.log
*.dmp
debug.log

# Build / distribution outputs
/dist/
/build/
/out/
*.zip

# Node (if used for tooling)
node_modules/

# Dependencies
# Ignore generic lib folders at repo root, but do NOT ignore the vendored libraries contained in Chatter/Libs
/lib/
/libs/
!Chatter/Libs/
!Chatter/Libs/**

# Environment / secrets
.env
.env.local
.env.*.local
